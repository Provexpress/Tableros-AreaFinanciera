PBI_API_BASE_URL=http://152.200.146.226:50010
PBI_API_USER=
PBI_API_PASSWORD=

# Opcional, si el endpoint de token usa otros nombres de campos.
PBI_API_AUTH_MODE=auto
PBI_API_USER_FIELD=username
PBI_API_PASSWORD_FIELD=password
PBI_API_TOKEN_HEADER=Authorization

# Cambiar a 2026 cuando ya solo se quiera publicar información reciente.
PBI_CACHE_MIN_YEAR=2024

# Microsoft Graph / SharePoint. Se usa en GitHub Actions para descargar
# los Excel antes de reconstruir los caches locales.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_GRAPH_HOSTNAME=provexpress.sharepoint.com
MS_GRAPH_SITE_PATH=/sites/ProvexpressIntranet/Adminyfinanciero
MS_GRAPH_DRIVE_NAME=Documentos compartidos
MS_GRAPH_FOLDER_PATH=Facturación/Director de Facturación
MS_GRAPH_ACUSES_FOLDER_PATH=Facturación/Asistente documental/control de acuses/ACUSES 2026
MS_GRAPH_ACUSES_SEARCH_ROOT=Facturación
MS_GRAPH_ACUSES_SEARCH_DEPTH=5
MS_GRAPH_FILES=Control Facturas.xlsx,NOTAS CREDITO 2026.xlsx,reporte semanal de facturacion.xlsx
MS_GRAPH_DOWNLOAD_ACUSES=true
MS_GRAPH_ACUSE_PATTERN=acuse

# Login Microsoft 365 para la app web. Estas variables son públicas porque Vite
# las incluye en el navegador; no pongas secretos aquí.
VITE_AUTH_ENABLED=false
VITE_MS_CLIENT_ID=
VITE_MS_TENANT_ID=
VITE_AUTH_ALLOWED_EMAILS=usuario@provexpress.com,otro.usuario@provexpress.com
